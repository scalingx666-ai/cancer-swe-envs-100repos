+// check if a path is a regular file (seekable), not a pipe/FIFO/device
+inline bool is_regular_file(const  string& path)
+{
+    struct stat status;
+    if( stat( path.c_str(), &status ) != 0 )
+        return false;
+    return S_ISREG( status.st_mode );
+}
