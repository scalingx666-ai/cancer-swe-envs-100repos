+// Returns null when the rate is not found, so the sample is not filtered on --min_mapped_reads.
 //
 def getHisat2PercentMapped(align_log) {
-    def percent_aligned = 0
+    def percent_aligned = null
     def pattern = /Overall alignment rate:\s*([\d\.]+)%/
     align_log.eachLine { line ->
         def matcher = line =~ pattern
@@ -841,6 +842,9 @@ def getHisat2PercentMapped(align_log) {
             percent_aligned = matcher[0][1].toFloat()
         }
     }
+    if (percent_aligned == null) {
+        log.warn "Could not find the overall alignment rate in HISAT2 summary '${align_log.name}'; the sample will not be filtered on --min_mapped_reads."
+    }
     return percent_aligned
 }
 
diff --git a/subworkflows/local/utils_nfcore_rnaseq_pipeline/tests/main.function.nf.test b/subworkflows/local/utils_nfcore_rnaseq_pipeline/tests/main.function.nf.test
index 08a3bc7ce5..5f835347e6 100644
--- a/subworkflows/local/utils_nfcore_rnaseq_pipeline/tests/main.function.nf.test
+++ b/subworkflows/local/utils_nfcore_rnaseq_pipeline/tests/main.function.nf.test
@@ -626,4 +626,48 @@ nextflow_function {
             )
         }
     }
+
+    test("Test Function getHisat2PercentMapped parses the overall alignment rate") {
+
+        function "getHisat2PercentMapped"
+
+        when {
+            function {
+                """
+                def log_file = File.createTempFile('hisat2', '.summary.log')
+                log_file.text = 'HISAT2 summary stats:\\n\\tTotal pairs: 100\\n\\tOverall alignment rate: 96.84%\\n'
+                input[0] = log_file.toPath()
+                """
+            }
+        }
+
+        then {
+            assertAll(
+                { assert function.success },
+                { assert function.result == 96.84 }
+            )
+        }
+    }
+
+    test("Test Function getHisat2PercentMapped returns null when the rate is missing") {
+
+        function "getHisat2PercentMapped"
+
+        when {
+            function {
+                """
+                def log_file = File.createTempFile('hisat2', '.summary.log')
+                log_file.text = 'unexpected log format\\n'
+                input[0] = log_file.toPath()
+                """
+            }
+        }
+
+        then {
+            assertAll(
+                { assert function.success },
+                { assert function.result == null }
+            )
+        }
+    }
 }
